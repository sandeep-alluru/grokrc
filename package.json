{
  "name": "grokrc",
  "version": "0.1.0",
  "description": "Remote control for xAI's Grok Build CLI \u2014 drive your terminal coding agent from your phone over the agent's own protocol, not a screen scrape.",
  "type": "module",
  "license": "MIT",
  "author": "Sandeep Alluru",
  "homepage": "https://github.com/sandeep-alluru/grokrc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandeep-alluru/grokrc.git"
  },
  "bugs": {
    "url": "https://github.com/sandeep-alluru/grokrc/issues"
  },
  "keywords": [
    "acp",
    "agent",
    "agent-client-protocol",
    "ai-agent",
    "cli",
    "coding-agent",
    "grok",
    "grok-build",
    "mobile",
    "pwa",
    "remote-control",
    "self-hosted",
    "web-push",
    "xai"
  ],
  "bin": {
    "grokrc": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "web",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "npm run test:mock && npm run build && npm run test:real",
    "test:unit": "node --test --experimental-strip-types test/events.test.ts test/observer.test.ts test/preflight.test.ts test/push.test.ts test/relay.test.ts test/server.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "probe": "node tools/acp-probe.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,test,tools,web}/**/*.{ts,js,mjs}\" \"*.{json,js}\"",
    "format:check": "prettier --check \"{src,test,tools,web}/**/*.{ts,js,mjs}\" \"*.{json,js}\"",
    "test:mock": "node --test --experimental-strip-types --test-concurrency=1 test/*.test.ts",
    "test:real": "node tools/live-ui-check.mjs && node tools/resume-check.mjs"
  },
  "dependencies": {
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0"
  }
}
